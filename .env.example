# ============================================================
# NovaCommerce Core — Environment configuration template
# Copy to `.env` and fill in real values for local dev.
# Never commit real credentials.
# ============================================================

# ---------- Core ----------
ENV=dev                         # dev | staging | prod | test
DEBUG=true
SECRET_KEY=change-me-to-a-50-char-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# ---------- Database (PostgreSQL) ----------
POSTGRES_DB=novacommerce
POSTGRES_USER=novacommerce
POSTGRES_PASSWORD=novacommerce
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://novacommerce:novacommerce@postgres:5432/novacommerce

# Optional read replica for read-heavy queries (FastAPI, analytics)
DATABASE_READ_URL=

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_CHANNELS_URL=redis://redis:6379/2

# ---------- Celery ----------
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/4
CELERY_TASK_ALWAYS_EAGER=false

# ---------- JWT ----------
JWT_SIGNING_KEY=change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# ---------- Email ----------
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=noreply@novacommerce.local

# ---------- Sentry ----------
SENTRY_DSN=

# ---------- Stripe ----------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=

# ---------- PayPal ----------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ---------- Local Uzbekistan gateways ----------
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
UZUM_API_KEY=

# ---------- Search ----------
ELASTICSEARCH_URL=
MEILISEARCH_URL=
MEILISEARCH_KEY=

# ---------- Object storage (S3 / MinIO) ----------
S3_ENDPOINT_URL=
S3_BUCKET=novacommerce-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ---------- FastAPI ----------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001
FASTAPI_WORKERS=4

# ---------- Django ----------
DJANGO_SETTINGS_MODULE=novacommerce.settings.dev
DJANGO_HOST=0.0.0.0
DJANGO_PORT=8000

# ---------- Rate limiting ----------
RATE_LIMIT_ANON=60/minute
RATE_LIMIT_USER=300/minute

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Telemetry ----------
PROMETHEUS_MULTIPROC_DIR=/tmp/prom_multiproc
LOG_LEVEL=INFO
LOG_FORMAT=json                 # json | console
